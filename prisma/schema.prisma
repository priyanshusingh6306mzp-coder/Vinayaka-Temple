// Shri Vinayaka Temple - Database Schema
// Optimized for PostgreSQL on Neon (Serverless Free Tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
}

enum PoojaStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventCategory {
  SANKASHTI
  FESTIVAL
  SPECIAL_POOJA
  OTHER
}

// User model for Admin / Priest authentication
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               Role     @default(ADMIN)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

// Devotee Pooja Booking Requests
model PoojaRequest {
  id            String      @id @default(uuid())
  name          String
  phone         String
  email         String?
  poojaType     String
  dateRequested DateTime
  notes         String?
  status        PoojaStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("pooja_requests")
}

// Temple Events & Festival Schedule
model TempleEvent {
  id          String        @id @default(uuid())
  title       String
  category    EventCategory
  eventDate   DateTime      @db.Date
  startTime   String?
  description String?
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images      GalleryImage[]

  @@index([eventDate])
  @@map("temple_events")
}

// Temple Photo Gallery Images (Cloudinary)
model GalleryImage {
  id            String       @id @default(uuid())
  imageUrl      String
  publicId      String       @unique
  title         String
  caption       String?
  sortOrder     Int          @default(0)
  uploadedAt    DateTime     @default(now())
  eventId       String?
  event         TempleEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  featured      Boolean      @default(false)
  featuredOrder Int?

  @@index([sortOrder, uploadedAt])
  @@index([eventId])
  @@map("gallery_images")
}

// Postgres-backed sliding window rate limiter
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@map("rate_limits")
}

// Site settings key-value store (e.g. darshan timings)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
