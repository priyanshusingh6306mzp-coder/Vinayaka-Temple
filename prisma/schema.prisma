// Shri Vinayaka Temple - Database Schema
// Optimized for PostgreSQL on Neon (Serverless Free Tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for Admin / Priest authentication
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               String   @default("ADMIN")
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

// Devotee Pooja Booking Requests
model PoojaRequest {
  id             String      @id @default(cuid())
  name           String
  phone          String
  email          String?
  poojaType      String
  dateRequested  DateTime
  notes          String?
  status         PoojaStatus @default(PENDING)
  adminNotes     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@map("pooja_requests")
}

enum PoojaStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Temple Photo Gallery Images (Cloudinary)
model GalleryImage {
  id         String   @id @default(cuid())
  imageUrl   String
  publicId   String   @unique
  title      String
  caption    String?
  sortOrder  Int      @default(0)
  width      Int?
  height     Int?
  uploadedAt DateTime @default(now())

  @@index([sortOrder, uploadedAt])
  @@map("gallery_images")
}

// Postgres-backed sliding window rate limiter
model RateLimit {
  key         String   @id
  windowStart BigInt
  count       Int      @default(1)

  @@map("rate_limits")
}
