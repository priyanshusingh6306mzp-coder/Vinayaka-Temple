# ==============================================================================
# SHRI VINAYAKA TEMPLE - ENVIRONMENT VARIABLES
# Copy this file to .env and replace placeholder values with your real credentials.
# Total cost of running this project in production is ₹0 using free-tier services.
# ==============================================================================

# --- APPLICATION & PUBLIC URL ---
# Must be updated if deploying on Vercel (*.vercel.app) or attaching a custom domain
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- DATABASE: Neon Serverless PostgreSQL (Permanent Free Tier) ---
# Connection pooling string for application queries (port 6543 / pgbouncer=true)
DATABASE_URL="postgresql://neondb_owner:npg_sample_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection string for Prisma migrations (port 5432)
DIRECT_URL="postgresql://neondb_owner:npg_sample_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- AUTHENTICATION: Auth.js v5 / NextAuth ---
# Generate using: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="insecure-placeholder-secret-change-me-32-chars-long"
AUTH_URL="http://localhost:3000"

# --- INITIAL SEED CREDENTIALS ---
# Used exclusively by `npm run db:seed` to provision the primary admin user.
# The user will be required to change this password on first login.
ADMIN_EMAIL="priest@vinayaka.example.com"
ADMIN_INITIAL_PASSWORD="ChangeMeImmediately123!"

# --- CLOUDINARY: Image Storage (Permanent Free Tier) ---
# Signed direct uploads from admin portal; client compresses to max 1600px / 300KB
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- EMAIL NOTIFICATIONS: Gmail SMTP via Nodemailer (Free Tier) ---
# Optional: Non-blocking; if missing or incorrect, submissions still succeed and appear in admin dashboard.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="temple.notifications@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx" # 16-character Google App Password
SMTP_FROM_NAME="Shri Vinayaka Temple"
NOTIFICATION_RECIPIENT_EMAIL="priest@vinayaka.example.com"

# --- GOOGLE MAPS CONFIGURATION (Optional Override) ---
# Default map URLs live directly in code in src/content/site.ts.
# Specify these environment variables only if you need to override the default map URLs.

# NEXT_PUBLIC_MAPS_LINK=""

# --- BOT PROTECTION: Cloudflare Turnstile (Optional Free Tier) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
